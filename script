MainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 8) 
MainFrame.BorderSizePixel = 0 
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

local UIOutline = Instance.new("UIStroke", MainFrame)
UIOutline.Thickness = 2; UIOutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 45); Title.Text = "Genesis Universal ESP"
Title.TextColor3 = SETTINGS.Crimson; Title.TextSize = 20; Title.Font = SETTINGS.MainFont; Title.BackgroundTransparency = 1

local Layout = Instance.new("UIListLayout", MainFrame)
Layout.Padding = UDim.new(0, 5); Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center; Layout.SortOrder = Enum.SortOrder.LayoutOrder

-- Global Pulse Logic
local pulseValue = 0
RunService.RenderStepped:Connect(function()
    pulseValue = (math.sin(tick() * 4) + 1) / 2 
    UIOutline.Color = Color3.new((SETTINGS.Crimson.R * 0.7) + (pulseValue * 0.3), 0, 0)
end)

local function CleanAllHighlights()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("ESP_Cham")
            if h then h:Destroy() end
        end
    end
end

local function CreateToggle(name, stateKey, order)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 35); btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    btn.Text = "  " .. name; btn.Font = SETTINGS.MainFont; btn.TextColor3 = SETTINGS.Crimson; btn.TextSize = 19
    btn.AutoButtonColor = false; btn.TextXAlignment = Enum.TextXAlignment.Left; btn.LayoutOrder = order
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local CrossContainer = Instance.new("Frame", btn)
    CrossContainer.Size = UDim2.new(0, 25, 1, 0); CrossContainer.Position = UDim2.new(1, -35, 0, 0); CrossContainer.BackgroundTransparency = 1; CrossContainer.Visible = STATES[stateKey]

    -- Re-implementing the Glowing Pulse for Crosses
    local glowLayers = {}
    for i = 1, 3 do
        local Glow = Instance.new("TextLabel", CrossContainer)
        Glow.Size = UDim2.new(1, 0, 1, 0); Glow.BackgroundTransparency = 1; Glow.Text = "†"
        Glow.TextColor3 = SETTINGS.GlowCrimson; Glow.TextSize = 18 + (i * 2); Glow.Font = Enum.Font.GothamBold
        table.insert(glowLayers, Glow)
    end

    local MainCross = Instance.new("TextLabel", CrossContainer)
    MainCross.Size = UDim2.new(1, 0, 1, 0); MainCross.BackgroundTransparency = 1; MainCross.Text = "†"
    MainCross.TextColor3 = SETTINGS.Crimson; MainCross.TextSize = 20; MainCross.Font = Enum.Font.GothamBold

    -- Pulse Animation
    RunService.RenderStepped:Connect(function()
        if CrossContainer.Visible then
            local alpha = 0.3 + (pulseValue * 0.6)
            for _, g in pairs(glowLayers) do g.TextTransparency = 1 - (alpha * 0.5) end
            MainCross.TextTransparency = 1 - alpha
        end
    end)

    btn.MouseButton1Click:Connect(function()
        -- Robust Flash Logic: Forces color back to original to prevent getting stuck red
        btn.BackgroundColor3 = SETTINGS.FlashColor
        local returnTween = TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(15, 15, 15)})
        returnTween:Play()
        
        STATES[stateKey] = not STATES[stateKey]
        CrossContainer.Visible = STATES[stateKey]
        
        if stateKey == "Chams" and not STATES[stateKey] then CleanAllHighlights() end
    end)
end

