-- [[ ESP ENGINE ]] --
local function createESP(player)
    if player == LocalPlayer then return end
    local BoxOutline = Drawing.new("Square"); BoxOutline.Thickness = 3; BoxOutline.Color = Color3.new(0,0,0)
    local Box = Drawing.new("Square"); Box.Thickness = 1
    local tracerLine = Drawing.new("Line"); tracerLine.Thickness = 1

    local connection
    connection = RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not player.Parent then 
            connection:Disconnect(); Box:Remove(); BoxOutline:Remove(); tracerLine:Remove()
            return 
        end

        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Head") then
            Box.Visible = false; BoxOutline.Visible = false; tracerLine.Visible = false
            return
        end

        local root = char.HumanoidRootPart
        local head = char.Head
        local isSameTeam = (player.Team == LocalPlayer.Team and player.Team ~= nil)
        local shouldShow = STATES.Master and not (STATES.TeamCheck and isSameTeam)
        local teamCol = player.TeamColor.Color

        if shouldShow and STATES.Chams then
            local highlight = char:FindFirstChild("ESP_Cham")
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Cham"; highlight.Parent = char
                highlight.FillTransparency = 0.5; highlight.OutlineColor = Color3.new(1,1,1)
            end
            highlight.Enabled = true; highlight.FillColor = teamCol
        else
            local h = char:FindFirstChild("ESP_Cham")
            if h then h.Enabled = false end
        end

        local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if shouldShow and onScreen then
            if STATES.Boxes then
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                local h = math.abs(headPos.Y - legPos.Y); local w = h / 1.5
                Box.Size = Vector2.new(w, h); Box.Position = Vector2.new(rootPos.X - w/2, rootPos.Y - h/2); Box.Color = teamCol; Box.Visible = true
                BoxOutline.Size = Box.Size; BoxOutline.Position = Box.Position; BoxOutline.Visible = true
            else Box.Visible = false; BoxOutline.Visible = false end

            if STATES.Tracers then
                tracerLine.To = Vector2.new(rootPos.X, rootPos.Y); tracerLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); tracerLine.Color = teamCol; tracerLine.Visible = true
            else tracerLine.Visible = false end

            local bb = head:FindFirstChild("LS_Name") or Instance.new("BillboardGui", head)
            bb.Name = "LS_Name"; bb.Size = UDim2.new(0, 200, 0, 80); bb.AlwaysOnTop = true; bb.Enabled = true
            local label = bb:FindFirstChild("Label") or Instance.new("TextLabel", bb)
            label.Name = "Label"; label.BackgroundTransparency = 1; label.Size = UDim2.new(1,0,1,0); label.Font = Enum.Font.GothamBold; label.TextSize = SETTINGS.NameSize; label.TextColor3 = teamCol
            
            local txt = ""
            if STATES.Username then txt = player.Name elseif STATES.DisplayName then txt = player.DisplayName end
            if STATES.Distance then txt = txt .. " [" .. math.floor((root.Position - Camera.CFrame.Position).Magnitude / 3) .. "m]" end
            if STATES.Tools then local t = char:FindFirstChildOfClass("Tool") if t then txt = txt .. "\n" .. t.Name end end
            label.Text = txt
        else
            Box.Visible = false; BoxOutline.Visible = false; tracerLine.Visible = false
            if head:FindFirstChild("LS_Name") then head.LS_Name.Enabled = false end
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

UserInputService.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == SETTINGS.MenuKeybind then MainFrame.Visible = not MainFrame.Visible end
end)
